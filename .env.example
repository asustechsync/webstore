# Copia este archivo a apps/web/.env.local y completa los valores.
# NUNCA subas valores reales a git. Los secretos de cada cliente viven
# en su propio proyecto de Vercel y Supabase.

# Nombre visible de la tienda (más adelante vendrá de clients/<cliente>/client.config.ts)
NEXT_PUBLIC_STORE_NAME="Mi tienda"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (obligatorio desde el módulo auth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Solo servidor. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
