{
  "name": "webstore",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:paneles": "wt -d . pwsh -NoExit -c \"npm run dev -w @webstore/web\" ; split-pane -V -d . pwsh -NoExit -c \"npm run dev -w @webstore/admin\"",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generar": "npm run generar -w @webstore/db",
    "db:migrar": "npm run migrar -w @webstore/db"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "fast-glob": "npm:tinyglobby@^0.2.17"
  }
}
