generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Usuarios, roles y permisos ─────────────────────────────

model Usuario {
  id              String      @id @default(uuid())
  authId          String      @unique // id del usuario en Supabase Auth
  email           String      @unique
  nombre          String
  apellidoPaterno String?
  apellidoMaterno String?
  telefono        String?
  codigoPais      String?     @default("+51")
  fechaNacimiento DateTime?
  genero          String?
  tipoDocumento   String?
  documento       String?     @unique
  rolId           String
  rol             Rol         @relation(fields: [rolId], references: [id])
  direcciones     Direccion[]
  pedidos         Pedido[]
  carrito         Carrito?
  creadoEn        DateTime    @default(now())
  actualizadoEn   DateTime    @updatedAt

  @@map("usuarios")
}

model Rol {
  id       String       @id @default(uuid())
  nombre   String       @unique // ADMIN, CLIENTE, ALMACEN, VENTAS, DESPACHO...
  permisos RolPermiso[]
  usuarios Usuario[]

  @@map("roles")
}

model Permiso {
  id    String       @id @default(uuid())
  clave String       @unique // "productos.crear", "stock.editar", "pedidos.despachar"...
  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String
  permisoId String
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model Direccion {
  id             String   @id @default(uuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  destinatario   String
  telefono       String
  departamento   String
  provincia      String
  distrito       String
  direccion      String
  codigoPostal   String?
  referencia     String?
  predeterminada Boolean  @default(false)
  creadoEn       DateTime @default(now())

  @@map("direcciones")
}

// ── Catálogo: marcas, categorías, productos ────────────────

model Marca {
  id        String     @id @default(uuid())
  nombre    String     @unique
  slug      String     @unique
  logoUrl   String? // URL de Cloudinary
  activo    Boolean    @default(true)
  productos Producto[]
  creadoEn  DateTime   @default(now())

  @@map("marcas")
}

model Categoria {
  id             String      @id @default(uuid())
  nombre         String
  slug           String      @unique
  descripcion    String?
  imagenUrl      String? // URL de Cloudinary
  orden          Int         @default(0) // menor número = aparece primero
  destacada      Boolean     @default(false) // se muestra en la portada
  tituloSeo      String?     @map("titulo_seo")
  descripcionSeo String?     @map("descripcion_seo")
  padreId        String?
  padre          Categoria?  @relation("SubCategorias", fields: [padreId], references: [id])
  subcategorias  Categoria[] @relation("SubCategorias")
  productos      Producto[]
  activo         Boolean     @default(true)
  creadoEn       DateTime    @default(now())

  @@index([activo, orden])
  @@map("categorias")
}

// Catálogo reutilizable de atributos para no volver a escribir talla, color
// u otras opciones en cada producto. Al aplicarlo a un producto se copia como
// una opción propia, preservando su historial aunque el catálogo cambie luego.
model AtributoCatalogo {
  id            String                  @id @default(uuid())
  nombre        String
  clave         String                  @unique
  tipo          String                  @default("LISTA") // LISTA | COLOR
  activo        Boolean                 @default(true)
  valores       ValorAtributoCatalogo[]
  creadoEn      DateTime                @default(now()) @map("creado_en")
  actualizadoEn DateTime                @updatedAt @map("actualizado_en")

  @@map("atributos_catalogo")
}

model ValorAtributoCatalogo {
  id         String           @id @default(uuid())
  atributoId String           @map("atributo_id")
  atributo   AtributoCatalogo @relation(fields: [atributoId], references: [id], onDelete: Cascade)
  valor      String
  colorHex   String?          @map("color_hex")
  orden      Int              @default(0)

  @@unique([atributoId, valor])
  @@index([atributoId])
  @@map("valores_atributo_catalogo")
}

model Producto {
  id               String           @id @default(uuid())
  nombre           String
  slug             String           @unique
  descripcion      String
  descripcionCorta String?
  skuInterno       String?          @unique
  codigoBarras     String?          @unique
  proveedor        String?
  precio           Decimal          @db.Decimal(10, 2)
  precioOferta     Decimal?         @db.Decimal(10, 2)
  costo            Decimal?         @db.Decimal(10, 2) // costo base actual; la variante puede sobrescribirlo
  sku              String           @unique // código base; cada variante tiene el suyo
  borrador         Boolean          @default(true)
  modoVariantes    Boolean          @default(false)
  tipoProducto     String? // MEDIAS_MUJER, BOXER_ADULTO, BRASIER, PERSONALIZADO...
  perfilOpciones   String? // preset usado por el editor; no limita opciones futuras
  categoriaId      String
  categoria        Categoria        @relation(fields: [categoriaId], references: [id])
  marcaId          String?
  marca            Marca?           @relation(fields: [marcaId], references: [id])
  imagenes         ImagenProducto[]
  opciones         OpcionProducto[]
  variantes        Variante[]
  material         String? // "95% algodón, 5% elastano"
  cuidados         String? // "Lavar a máquina en frío, no usar secadora"
  guiaTallas       String?
  pesoKg           Decimal?         @db.Decimal(8, 3)
  anchoCm          Decimal?         @db.Decimal(8, 2)
  altoCm           Decimal?         @db.Decimal(8, 2)
  largoCm          Decimal?         @db.Decimal(8, 2)
  tituloSeo        String?
  descripcionSeo   String?
  activo           Boolean          @default(true)
  destacado        Boolean          @default(false)
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  @@index([categoriaId])
  @@index([marcaId])
  @@map("productos")
}

model ImagenProducto {
  id         String   @id @default(uuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  url        String // URL de Cloudinary
  publicId   String // public_id de Cloudinary, para poder borrarla
  orden      Int      @default(0)

  @@map("imagenes_producto")
}

// Opciones configurables del producto: Talla, Color, Contorno, Copa, Edad...
// Se modelan como datos y no como columnas para admitir nuevos tipos de
// producto sin volver a modificar el esquema.
model OpcionProducto {
  id         String                @id @default(uuid())
  productoId String
  producto   Producto              @relation(fields: [productoId], references: [id], onDelete: Cascade)
  clave      String // talla, color, contorno, copa...
  nombre     String
  orden      Int                   @default(0)
  valores    ValorOpcionProducto[]

  @@unique([productoId, clave])
  @@index([productoId])
  @@map("opciones_producto")
}

model ValorOpcionProducto {
  id        String          @id @default(uuid())
  opcionId  String
  opcion    OpcionProducto  @relation(fields: [opcionId], references: [id], onDelete: Cascade)
  valor     String
  orden     Int             @default(0)
  variantes ValorVariante[]

  @@unique([opcionId, valor])
  @@index([opcionId])
  @@map("valores_opcion_producto")
}

// ── Variantes: la unidad que realmente se vende ────────────
// En ropa el stock no vive en el producto sino en cada combinación de talla y
// color, así que el carrito y los pedidos apuntan acá, no a Producto.

model Variante {
  id             String          @id @default(uuid())
  productoId     String
  producto       Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  talla          String // S, M, L, XL, 28, 30, Única...
  color          String          @default("") // "" = sin color; evita NULLs en el índice único
  claveOpciones  String // representación canónica para impedir combinaciones duplicadas
  sku            String          @unique
  precio         Decimal?        @db.Decimal(10, 2) // opcional: sobrescribe el precio del producto
  costo          Decimal?        @db.Decimal(10, 2) // opcional: sobrescribe el costo base
  cantidad       Int             @default(0)
  stockMinimo    Int             @default(0)
  activo         Boolean         @default(true)
  // Portada propia de la variante; si es null se usa la del producto.
  imagenUrl      String?
  imagenPublicId String?
  itemsCarrito   ItemCarrito[]
  itemsPedido    ItemPedido[]
  valores        ValorVariante[]
  creadoEn       DateTime        @default(now())
  actualizadoEn  DateTime        @updatedAt

  @@unique([productoId, claveOpciones])
  @@index([productoId])
  @@map("variantes")
}

model ValorVariante {
  varianteId String
  valorId    String
  variante   Variante            @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  valor      ValorOpcionProducto @relation(fields: [valorId], references: [id], onDelete: Cascade)

  @@id([varianteId, valorId])
  @@index([valorId])
  @@map("valores_variante")
}

// ── Carrito persistido (para usuarios logueados) ───────────
// El carrito de invitados vive solo en localStorage (Zustand); este se
// sincroniza al iniciar sesión para no perder el carrito entre dispositivos.

model Carrito {
  id            String        @id @default(uuid())
  usuarioId     String        @unique
  usuario       Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items         ItemCarrito[]
  actualizadoEn DateTime      @updatedAt

  @@map("carritos")
}

model ItemCarrito {
  id         String   @id @default(uuid())
  carritoId  String
  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  cantidad   Int      @default(1)

  @@unique([carritoId, varianteId])
  @@map("items_carrito")
}

// ── Pedidos (base para checkout / fase 3 facturación y envíos) ─

model Pedido {
  id                String       @id @default(uuid())
  usuarioId         String
  usuario           Usuario      @relation(fields: [usuarioId], references: [id])
  items             ItemPedido[]
  estado            EstadoPedido @default(PENDIENTE)
  subtotal          Decimal      @default(0) @db.Decimal(10, 2)
  costoEnvio        Decimal      @default(0) @db.Decimal(10, 2)
  total             Decimal      @db.Decimal(10, 2)
  descuento         Decimal      @default(0) @db.Decimal(10, 2)
  metodoPago        MetodoPago?
  cuponId           String?
  cupon             Cupon?       @relation(fields: [cuponId], references: [id])
  // Copia de la dirección al comprar: el pedido no debe cambiar si luego se
  // edita o elimina la dirección del cliente.
  envioDestinatario String?
  envioTelefono     String?
  envioDepartamento String?
  envioProvincia    String?
  envioDistrito     String?
  envioDireccion    String?
  envioReferencia   String?
  envioCodigoPostal String?
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  @@index([usuarioId])
  @@index([estado, creadoEn])
  @@index([cuponId])
  @@map("pedidos")
}

model ItemPedido {
  id         String   @id @default(uuid())
  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id])
  cantidad   Int
  precioUnit Decimal  @db.Decimal(10, 2)
  costoUnit  Decimal? @db.Decimal(10, 2) // snapshot del costo al confirmar la venta

  @@index([pedidoId])
  @@index([varianteId])
  @@map("items_pedido")
}

enum MetodoPago {
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  EN_PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
}

// ── Marketing: cupones de descuento ────────────────────────

model Cupon {
  id            String    @id @default(uuid())
  codigo        String    @unique
  tipo          TipoCupon
  valor         Decimal   @db.Decimal(10, 2) // % si tipo=PORCENTAJE, soles si tipo=MONTO_FIJO
  montoMinimo   Decimal?  @db.Decimal(10, 2)
  usoMaximo     Int? // null = sin límite de usos
  usosActuales  Int       @default(0)
  fechaInicio   DateTime?
  fechaFin      DateTime?
  activo        Boolean   @default(true)
  pedidos       Pedido[]
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@index([activo, fechaFin])
  @@map("cupones")
}

enum TipoCupon {
  PORCENTAJE
  MONTO_FIJO
}
