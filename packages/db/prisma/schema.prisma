generator client {
  provider = "prisma-client"
  output   = "../src/generado"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  CLIENTE
  ADMIN
  ALMACEN
}

enum TipoDocumento {
  DNI
  RUC
  CE
  PASAPORTE
}

enum EstadoPedido {
  PENDIENTE
  PAGADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  RESERVA
  DEVOLUCION
}

model Usuario {
  id         String      @id @default(cuid())
  correo     String      @unique
  nombres    String
  apellidos  String      @default("")
  telefono   String?
  fechaNacimiento DateTime? @db.Date
  claveHash  String?
  rol        Rol         @default(CLIENTE)
  creadoEn   DateTime    @default(now())
  actualizadoEn DateTime  @default(now()) @updatedAt
  activo     Boolean     @default(true)
  /// Documento para la facturación SUNAT: DNI en boleta, RUC en factura
  tipoDocumento   TipoDocumento?
  numeroDocumento String?
  razonSocial     String?
  correoVerificadoEn DateTime?
  ultimoAccesoEn     DateTime?
  direcciones Direccion[]
  carritos   Carrito[]
  pedidos    Pedido[]
}

model Direccion {
  id         String  @id @default(cuid())
  usuarioId  String
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  destinatario String
  linea1     String
  distrito   String
  ciudad     String
  referencia String?
  telefono   String
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  slug      String     @unique
  padreId   String?
  padre     Categoria? @relation("Arbol", fields: [padreId], references: [id])
  hijas     Categoria[] @relation("Arbol")
  descripcion     String?
  imagenUrl       String?
  activo          Boolean    @default(true)
  destacada       Boolean    @default(false)
  orden           Int        @default(0)
  metaTitulo      String?
  metaDescripcion String?
  creadoEn        DateTime   @default(now())
  actualizadoEn   DateTime   @default(now()) @updatedAt
  productos Producto[]
  atributos Atributo[]

  @@index([padreId])
}

enum TipoAtributo {
  LISTA
  NUMERO
  SI_NO
}

/// Donde se guarda el valor: PRODUCTO (igual para todas las variantes) o
/// VARIANTE (cambia segun la variante, ej. capacidad).
enum AmbitoAtributo {
  PRODUCTO
  VARIANTE
}

/// Define un atributo/filtro de una categoria (aplica tambien a sus subcategorias).
/// Los valores viven en ProductoAtributoValor o VarianteAtributoValor segun `ambito`.
model Atributo {
  id          String       @id @default(cuid())
  nombre      String
  clave       String
  tipo        TipoAtributo
  ambito      AmbitoAtributo @default(PRODUCTO)
  /// Unidad de medida para NUMERO: "GB", "W", "MHz"
  unidad      String?
  /// Valores permitidos para LISTA
  opciones    String[]
  categoriaId String
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  orden       Int          @default(0)
  activo      Boolean      @default(true)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @default(now()) @updatedAt
  valoresProducto  ProductoAtributoValor[]
  valoresVariante  VarianteAtributoValor[]

  @@unique([categoriaId, clave])
  @@index([categoriaId])
}

/// Valor de un atributo para el producto completo. Exactamente una columna `valor*`
/// va llena, segun Atributo.tipo (CHECK en prisma/sql/atributo-valores.sql).
model ProductoAtributoValor {
  id            String   @id @default(cuid())
  productoId    String
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  atributoId    String
  atributo      Atributo @relation(fields: [atributoId], references: [id], onDelete: Restrict)
  /// LISTA
  valorTexto    String?
  /// NUMERO
  valorNumero   Float?
  /// SI_NO
  valorBooleano Boolean?

  @@unique([productoId, atributoId])
  @@index([atributoId, valorTexto])
  @@index([atributoId, valorNumero])
}

/// Valor de un atributo que cambia segun la variante (ej. capacidad 16 GB / 32 GB).
model VarianteAtributoValor {
  id            String   @id @default(cuid())
  varianteId    String
  variante      Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  atributoId    String
  atributo      Atributo @relation(fields: [atributoId], references: [id], onDelete: Restrict)
  /// LISTA
  valorTexto    String?
  /// NUMERO
  valorNumero   Float?
  /// SI_NO
  valorBooleano Boolean?

  @@unique([varianteId, atributoId])
  @@index([atributoId, valorTexto])
  @@index([atributoId, valorNumero])
}

model Marca {
  id        String     @id @default(cuid())
  nombre    String     @unique
  slug      String     @unique
  descripcion   String?
  logoUrl       String?
  activo        Boolean    @default(true)
  destacada     Boolean    @default(false)
  metaTitulo      String?
  metaDescripcion String?
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @default(now()) @updatedAt
  productos Producto[]
}

model Producto {
  id          String    @id @default(cuid())
  nombre      String
  slug        String    @unique
  descripcion String
  /// Especificaciones técnicas flexibles: socket, TDP, DDR, etc.
  specs       Json      @default("{}")
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  marcaId     String
  marca       Marca     @relation(fields: [marcaId], references: [id])
  activo      Boolean   @default(true)
  destacado   Boolean   @default(false)
  metaTitulo      String?
  metaDescripcion String?
  creadoEn    DateTime  @default(now())
  actualizadoEn DateTime  @default(now()) @updatedAt
  variantes   Variante[]
  atributos   ProductoAtributoValor[]

  @@index([categoriaId])
  @@index([marcaId])
}

model Variante {
  id          String   @id @default(cuid())
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  sku         String   @unique
  nombre      String
  /// Céntimos
  precio      Int
  imagenes    String[]
  activo      Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @default(now()) @updatedAt
  movimientos MovimientoStock[]
  itemsCarrito ItemCarrito[]
  itemsPedido  ItemPedido[]
  atributos    VarianteAtributoValor[]

  @@index([productoId])
}

/// El stock sale de la suma de estos movimientos. Nunca se actualiza directo.
model MovimientoStock {
  id          String         @id @default(cuid())
  varianteId  String
  variante    Variante       @relation(fields: [varianteId], references: [id])
  tipo        TipoMovimiento
  cantidad    Int
  motivo      String?
  pedidoId    String?
  creadoEn    DateTime       @default(now())

  @@index([varianteId])
}

model Carrito {
  id        String        @id @default(cuid())
  usuarioId String?
  usuario   Usuario?      @relation(fields: [usuarioId], references: [id])
  creadoEn  DateTime      @default(now())
  items     ItemCarrito[]
}

model ItemCarrito {
  id         String   @id @default(cuid())
  carritoId  String
  carrito    Carrito  @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id])
  cantidad   Int

  @@unique([carritoId, varianteId])
}

model Pedido {
  id         String       @id @default(cuid())
  numero     Int          @unique @default(autoincrement())
  usuarioId  String?
  usuario    Usuario?     @relation(fields: [usuarioId], references: [id])
  correo     String
  estado     EstadoPedido @default(PENDIENTE)
  /// Dirección copiada al momento de la compra (congelada)
  direccion  Json
  subtotal   Int
  envio      Int          @default(0)
  total      Int
  creadoEn   DateTime     @default(now())
  items      ItemPedido[]
  pagos      Pago[]
}

/// Nombre, talla/variante y precio congelados al momento de la venta.
model ItemPedido {
  id         String   @id @default(cuid())
  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id])
  nombre     String
  sku        String
  precio     Int
  cantidad   Int
}

model Pago {
  id         String     @id @default(cuid())
  pedidoId   String
  pedido     Pedido     @relation(fields: [pedidoId], references: [id])
  metodo     String
  referencia String?
  monto      Int
  estado     EstadoPago @default(PENDIENTE)
  creadoEn   DateTime   @default(now())
}
